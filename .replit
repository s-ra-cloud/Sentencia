modules = ["nodejs-20", "postgresql-16", "python-3.11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Preview Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sentencing Tree App"

[[workflows.workflow]]
name = "Preview Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Sentencing Tree App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sentencing-tree && python -m uvicorn main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "ocl-icd", "opencl-headers", "pkg-config", "qhull", "tcl", "tk", "unzip"]

[userenv]

[userenv.shared]
ADMIN_PASSWORD = "Trismegiste"

[deployment]
run = ["node", "server.js"]
deploymentTarget = "autoscale"
